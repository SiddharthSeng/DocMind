# ==============================================================================
# DocMind Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys & Secrets
# ------------------------------------------------------------------------------
# Required if LLM_BACKEND=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_placeholder_key_here_do_not_commit

# ------------------------------------------------------------------------------
# Deployment & Backend Selection
# ------------------------------------------------------------------------------
# Embedding engine: 'ollama' (local) or 'hf_bge_small' (deployed)
EMBEDDING_BACKEND=ollama

# LLM engine: 'ollama' (local) or 'groq' (deployed)
LLM_BACKEND=ollama

# ------------------------------------------------------------------------------
# Model Settings (Ollama - Local)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ------------------------------------------------------------------------------
# Model Settings (Groq - Deployed)
# ------------------------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-20b
# Alternatives: openai/gpt-oss-120b (higher reasoning, slightly slower),
#               allam-2-7b (faster but less accurate on multi-step RAG).
# Note: llama-3.1-8b-instant was decommissioned by Groq in September 2026.
# See https://console.groq.com/docs/models for the current available models.

# ------------------------------------------------------------------------------
# RAG Abstention Gate Thresholds (COSINE SIMILARITY, not fused RRF)
# The gate uses raw cosine similarity (embed_score) to decide whether to call
# the LLM.  Retrieval ranking still uses fused RRF (BM25 + embedding).
# Calibrated for bge-small-en-v1.5 on baked 5-chunk corpus (Sept 2026).
# ------------------------------------------------------------------------------
MIN_SIMILARITY_THRESHOLD=0.60
ABSTAIN_THRESHOLD=0.55

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
# The URL where the backend is running.
# Local: http://localhost:8000
# Deployed: https://your-backend.onrender.com (example)
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Optional: Alternative Embedding Backends
# (Only needed if you change EMBEDDING_BACKEND from its default)
# ------------------------------------------------------------------------------

# Required ONLY if EMBEDDING_BACKEND=nomic_api (Nomic Atlas cloud API).
# Sign up for a free key at https://atlas.nomic.ai
# NOT needed for EMBEDDING_BACKEND=hf_bge_small (local sentence-transformers) or ollama.
NOMIC_API_KEY=

# Required ONLY if using the HF Inference API embedding backend (EMBEDDING_BACKEND=hf_api).
# This is NOT the same as EMBEDDING_BACKEND=hf_bge_small, which loads the model locally
# via sentence-transformers and needs no API token at all.
# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
