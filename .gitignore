# Python cache files — generated automatically by Python when you run your code.
# They speed up re-imports but are machine-specific; no point tracking them.
__pycache__/
*.pyc
*.pyo

# Virtual environment — contains all your installed packages.
# Never commit this; instead, track requirements.txt so others can recreate it.
venv/
.venv/
env/

# Environment variables — may contain API keys, secrets, passwords.
# NEVER commit this file to a public repo.
.env

# ChromaDB local database — auto-generated by vector_store.py.
# Like processed_chunks.json, this is a build artifact, not source code.
chroma_db/

# Processed chunks — this is a build artifact generated by data_ingestion.py,
# not source code. Anyone can regenerate it by running data_ingestion.py.
# NOTE: We are intentionally NOT using *.json here — test_cases.json (coming later)
# should be tracked. We only exclude this specific file.
processed_chunks.json

# Source documents — excluded because they may be private/copyrighted.
# The docs/ folder structure is still tracked via docs/.gitkeep below.
docs/*
# This line un-excludes (keeps) .gitkeep, so the empty folder is visible in git.
!docs/.gitkeep
